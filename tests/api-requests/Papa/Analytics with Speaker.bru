tests {
  // Speaker-level analytics: per-speaker word counts, argument introductions,
  // direct/indirect argument receptions.

  test("Response status should be 200", function () {
    expect(res.status).to.equal(200);
  });

  test("Response should match expected output", function () {
    const expected = require('./test-inputs/expected_speaker.json');
    const body = res.getBody();
    expect(body).to.deep.equal(expected);
  });
}
